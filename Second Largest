#include <stdio.h>

int main() {
    int a[100], n, largest, second, found = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    if (n < 2 || n > 100) {
        printf("Invalid array size");
        return 0;
    }

    printf("Enter array elements: ");
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    largest = a[0];

    for (int i = 1; i < n; i++) {
        if (a[i] > largest)
            largest = a[i];
    }

    for (int i = 0; i < n; i++) {
        if (a[i] < largest) {
            if (!found || a[i] > second) {
                second = a[i];
                found = 1;
            }
        }
    }

    if (found)
        printf("Second Largest = %d", second);
    else
        printf("Second largest element not found");

    return 0;
}
