#include <stdio.h>

int main() {
    int n, temp, digit, fact, sum = 0;

    printf("Enter a number: ");
    scanf("%d", &n);

    temp = n;

    do {
        digit = temp % 10;
        fact = 1;

        for (int i = 1; i <= digit; i++) {
            fact = fact * i;
        }

        sum = sum + fact;
        temp = temp / 10;

    } while (temp > 0);

    if (sum == n)
        printf("%d is a Strong Number", n);
    else
        printf("%d is Not a Strong Number", n);

    return 0;
}
